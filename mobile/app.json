{
  "expo": {
    "name": "ShootGo",
    "slug": "shootgo",
    "owner": "murat6155",
    "scheme": "shootgo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ShootGo needs access to your photos so you can add product photos to listings.",
          "cameraPermission": "ShootGo needs camera access so you can take product photos for listings."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ShootGo uses your location to help fill in the area for your listing."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shootgo.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shootgo.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "df4afc8a-1df8-4012-835f-752121e06e1a"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
